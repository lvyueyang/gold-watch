{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gold-watch",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gold-watch-db",
			"database_id": "a941e77b-f242-4de2-b031-5dcaf6d5347c"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_QUOTES",
			"id": "3d78c6b881c64ff3ae846a35f3f0b7f0"
		}
	],
	
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
